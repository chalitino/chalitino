{
  "name": "wicotreats-b2b",
  "private": true,
  "version": "0.1.0",
  "description": "WicoTreats B2B-bestelportaal: standalone website (apps/web) en API (apps/api)",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "db:up": "docker compose up -d db",
    "db:migrate": "pnpm --filter @wicotreats/api prisma:migrate",
    "db:seed": "pnpm --filter @wicotreats/api prisma:seed"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma",
      "esbuild",
      "sharp"
    ]
  }
}
