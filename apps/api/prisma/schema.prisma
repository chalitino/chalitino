// WicoTreats B2B — datamodel
// Producten worden gesynct uit Shopify; klanten, prijslijsten en orders zijn eigen data.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN    // WicoTreats beheer: alles
  STAFF    // WicoTreats medewerker: orders, voorraad/batches
  CUSTOMER // dealer
}

enum UnitType {
  PACK // consumentenverpakking of kleinverpakking, bv. 100 g / 5 st
  BULK // bulk, bv. 1 kg
}

enum VatScheme {
  NL_VAT            // Nederlandse btw
  EU_REVERSE_CHARGE // EU, geldig btw-nummer: btw verlegd
  EXPORT            // buiten EU: 0%
}

enum PaymentTerms {
  PREPAID    // vooruitbetalen (eerste orders)
  ON_ACCOUNT // op rekening, binnen paymentTermDays
}

enum PaymentStatus {
  UNPAID
  PAID
}

enum CompanyStatus {
  PENDING   // aangevraagd, nog niet goedgekeurd
  ACTIVE
  BLOCKED
}

enum OrderStatus {
  RECEIVED
  PROCESSING
  SHIPPED
  INVOICED
  CANCELLED
}

model Company {
  id              String        @id @default(cuid())
  name            String
  kvkNumber       String?
  vatNumber       String?
  email           String
  phone           String?
  companyType     String? // Dierenspeciaalzaak, Groothandel / distributeur, ...
  website         String?
  howFound        String?
  requestNote     String?
  status          CompanyStatus @default(PENDING)
  paymentTermDays Int           @default(14)
  prepaidOrders   Int           @default(2) // aantal eerste orders dat vooruitbetaald moet worden
  vatValidated    Boolean       @default(false) // btw-nummer gecontroleerd via VIES
  vatValidatedAt  DateTime?
  vatCheckNote    String?
  // Adressen
  invoiceStreet   String?
  invoicePostcode String?
  invoiceCity     String?
  invoiceCountry  String        @default("NL")
  shipStreet      String?
  shipPostcode    String?
  shipCity        String?
  shipCountry     String        @default("NL")
  locale          String?       // taal voor mails en documenten: nl, en of leeg = automatisch (NL/BE → nl, anders en)

  priceList   PriceList? @relation(fields: [priceListId], references: [id])
  priceListId String?

  users  User[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(CUSTOMER)
  company      Company? @relation(fields: [companyId], references: [id])
  companyId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Product {
  id          String  @id @default(cuid())
  shopifyId   String? @unique
  handle      String  @unique
  title       String
  description String?
  productType String? // bv. Hondensnack
  animal      String? // bv. Rund, Kip, Lam, Eend, Hert
  tags        String[]
  imageUrl    String?
  b2bActive   Boolean @default(true)

  variants ProductVariant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductVariant {
  id          String   @id @default(cuid())
  shopifyId   String?  @unique
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId   String
  sku         String   @unique
  title       String // bv. "250 g", "Bulk 1 kg", "5 stuks"
  unitType    UnitType @default(PACK)
  packContent String? // inhoud per eenheid, bv. "100 g", "5 st", "1 kg"
  ean         String?
  caseSize    Int      @default(1) // stuks per omdoos
  orderInCase Boolean  @default(false) // alleen per omdoos bestelbaar
  retailPrice Decimal? @db.Decimal(10, 2) // consumentenadviesprijs incl. btw (uit Shopify), leeg voor bulk
  vatRate     Decimal  @default(9) @db.Decimal(5, 2) // diervoeding = 9% in NL
  weightGrams Int?
  b2bActive   Boolean  @default(true)

  // Voorraad is de som van batches.qtyRemaining (eigen B2B-voorraad, los van Shopify)
  batches    Batch[]
  prices     PriceListItem[]
  orderLines OrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PriceList {
  id        String          @id @default(cuid())
  name      String          @unique // bv. Dealer, Groothandel
  currency  String          @default("EUR")
  isDefault Boolean         @default(false)
  items     PriceListItem[]
  companies Company[]
  createdAt DateTime        @default(now())
}

// Prijs excl. btw per variant; meerdere regels met minQty geven staffels.
model PriceListItem {
  id          String         @id @default(cuid())
  priceList   PriceList      @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  priceListId String
  variant     ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId   String
  minQty      Int            @default(1)
  price       Decimal        @db.Decimal(10, 2)

  @@unique([priceListId, variantId, minQty])
}

model Order {
  id          String      @id @default(cuid())
  number      Int         @unique @default(autoincrement())
  company     Company     @relation(fields: [companyId], references: [id])
  companyId   String
  placedById  String
  reference   String? // klantreferentie / inkoopordernummer
  note        String?
  status      OrderStatus @default(RECEIVED)
  vatScheme     VatScheme     @default(NL_VAT)
  paymentTerms  PaymentTerms  @default(ON_ACCOUNT)
  paymentStatus PaymentStatus @default(UNPAID)
  paidAt        DateTime?
  dueDate       DateTime?
  trackingCode  String?
  trackingUrl   String?
  shippedAt     DateTime?
  invoiceNumber String?   @unique // bv. F2026-0001, toegekend bij verzending
  invoicedAt    DateTime?
  subtotalExVat Decimal   @db.Decimal(10, 2)
  vatTotal      Decimal   @db.Decimal(10, 2)
  shippingExVat Decimal   @default(0) @db.Decimal(10, 2)
  totalIncVat   Decimal   @db.Decimal(10, 2)
  shipStreet    String?
  shipPostcode  String?
  shipCity      String?
  shipCountry   String    @default("NL")
  lines         OrderLine[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model OrderLine {
  id          String         @id @default(cuid())
  order       Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId     String
  variant     ProductVariant @relation(fields: [variantId], references: [id])
  variantId   String
  sku         String
  title       String
  qty         Int
  unitPriceExVat Decimal     @db.Decimal(10, 2) // vastgelegd op moment van bestellen
  vatRate     Decimal        @db.Decimal(5, 2)
  lineTotalExVat Decimal     @db.Decimal(10, 2)
  batches     OrderLineBatch[]
}

// Ontvangen partij met THT. Voorraad = som van qtyRemaining.
model Batch {
  id           String         @id @default(cuid())
  variant      ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  variantId    String
  batchNumber  String
  bestBefore   DateTime       @db.Date // THT
  qtyReceived  Int
  qtyRemaining Int
  analysis     String? // analyse van de partij, bv. "Vocht 12% · E 68% · V 8% · A 6%"
  note         String?
  receivedAt   DateTime       @default(now())
  allocations  OrderLineBatch[]

  @@unique([variantId, batchNumber])
  @@index([variantId, bestBefore])
}

// Koppeling orderregel ↔ batch (FEFO: kortste THT eerst), voor traceerbaarheid.
model OrderLineBatch {
  id          String    @id @default(cuid())
  orderLine   OrderLine @relation(fields: [orderLineId], references: [id], onDelete: Cascade)
  orderLineId String
  batch       Batch     @relation(fields: [batchId], references: [id])
  batchId     String
  qty         Int
}

// Eenmalige inlogcode per e-mail (geen wachtwoord nodig), zoals in het WicoTreats-thema.
model LoginCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([email, code])
}

model Setting {
  key   String @id
  value String
}
