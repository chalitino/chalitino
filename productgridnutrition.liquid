{% comment %}
  Product grid with nutrition facts (fat / protein).

  Reads fat/protein from product metafields — see snippets/nutrition-facts.liquid
  for the required metafield definitions.
{% endcomment %}

<div
  class="product-grid-nutrition-section color-{{ section.settings.color_scheme }}"
  style="--pgn-columns-desktop: {{ section.settings.columns_desktop }}; --pgn-columns-mobile: {{ section.settings.columns_mobile }};"
>
  <div class="page-width">
    {% if section.settings.heading != blank or section.settings.subheading != blank %}
      <div class="product-grid-nutrition-section__header">
        {% if section.settings.heading != blank %}
          <h2 class="product-grid-nutrition-section__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.subheading != blank %}
          <p class="product-grid-nutrition-section__subheading">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    {% liquid
      if section.settings.collection != blank
        assign products = section.settings.collection.products
      else
        assign products = collections.all.products
      endif
      assign limit = section.settings.products_to_show
    %}

    <ul class="product-grid-nutrition" role="list">
      {% for product in products limit: limit %}
        <li class="product-grid-nutrition__item">
          <a href="{{ product.url }}" class="product-grid-nutrition__link">
            <div class="product-grid-nutrition__image-wrapper">
              {% if product.featured_image %}
                <img
                  class="product-grid-nutrition__image"
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  srcset="
                    {{ product.featured_image | image_url: width: 300 }} 300w,
                    {{ product.featured_image | image_url: width: 600 }} 600w,
                    {{ product.featured_image | image_url: width: 900 }} 900w
                  "
                  sizes="(min-width: 990px) 25vw, 50vw"
                  alt="{{ product.featured_image.alt | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                <div class="product-grid-nutrition__placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
              {% endif %}
            </div>

            <div class="product-grid-nutrition__info">
              <h3 class="product-grid-nutrition__title">{{ product.title }}</h3>
              <span class="product-grid-nutrition__price">
                {%- if product.price_varies -%}
                  {{ 'products.product.price.from_price_html' | t: price: product.price_min | money }}
                {%- else -%}
                  {{ product.price | money }}
                {%- endif -%}
              </span>

              {% render 'nutrition-facts',
                product: product,
                show_fat: section.settings.show_fat,
                show_protein: section.settings.show_protein
              %}
            </div>
          </a>
        </li>
      {% else %}
        <li class="product-grid-nutrition__empty">No products found.</li>
      {% endfor %}
    </ul>
  </div>
</div>

{% stylesheet %}
  .product-grid-nutrition-section {
    padding: 3rem 0;
  }

  .product-grid-nutrition-section__header {
    text-align: center;
    max-width: 60rem;
    margin: 0 auto 2.5rem;
  }

  .product-grid-nutrition-section__heading {
    margin: 0 0 0.5rem;
  }

  .product-grid-nutrition-section__subheading {
    margin: 0;
    color: rgba(var(--color-foreground, 0, 0, 0), 0.75);
  }

  .product-grid-nutrition {
    display: grid;
    grid-template-columns: repeat(var(--pgn-columns-mobile, 2), 1fr);
    gap: 1.5rem 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .product-grid-nutrition {
      grid-template-columns: repeat(var(--pgn-columns-desktop, 4), 1fr);
      gap: 2rem 1.5rem;
    }
  }

  .product-grid-nutrition__link {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .product-grid-nutrition__image-wrapper {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 0.75rem;
    background: rgba(0, 0, 0, 0.04);
  }

  .product-grid-nutrition__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .product-grid-nutrition__link:hover .product-grid-nutrition__image {
    transform: scale(1.04);
  }

  .product-grid-nutrition__placeholder {
    width: 100%;
    height: 100%;
  }

  .product-grid-nutrition__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .product-grid-nutrition__info {
    padding-top: 0.75rem;
  }

  .product-grid-nutrition__title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0 0 0.25rem;
  }

  .product-grid-nutrition__price {
    display: block;
    font-size: 0.95rem;
    opacity: 0.85;
    margin-bottom: 0.5rem;
  }

  .product-grid-nutrition__empty {
    grid-column: 1 / -1;
    text-align: center;
    opacity: 0.7;
  }

  .nutrition-facts {
    display: flex;
    gap: 0.5rem;
    margin: 0;
    flex-wrap: wrap;
  }

  .nutrition-facts__item {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    background: rgba(0, 0, 0, 0.06);
    font-size: 0.78rem;
    line-height: 1.4;
  }

  .nutrition-facts__label {
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .nutrition-facts__value {
    margin: 0;
    opacity: 0.85;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product grid (nutrition)",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop our treats"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave blank to show products from all collections"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Columns on desktop"
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "min": 1,
      "max": 2,
      "step": 1,
      "default": 2,
      "label": "Columns on mobile"
    },
    {
      "type": "checkbox",
      "id": "show_fat",
      "label": "Show fat",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_protein",
      "label": "Show protein",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Product grid (nutrition)"
    }
  ]
}
{% endschema %}
